DATABASE_URL=postgres://localhost:5432/sedjiwa_tasks
AUTH_JWT_SECRET=change-me
AUTH_JWT_EXPIRES_IN=7d
PORT=3010            # separate from Bun :3000 during transition (spec §2.1)
CORS_ORIGINS=http://localhost:3001

# Object storage. Media uploads are presigned PUTs the BROWSER performs, so
# S3_ENDPOINT must be reachable from the browser (not just from the backend),
# the keys must match the running rustfs/MinIO, and the bucket needs a CORS rule
# allowing the SPA origin — see scripts/setup-s3-cors.sh.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tasks-media
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
