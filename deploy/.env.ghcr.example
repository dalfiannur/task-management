# Copy to deploy/.env before running docker-compose.ghcr.yml.
#
#   cp .env.ghcr.example .env
#
# Nothing here has a default in the compose file. That is deliberate: this stack
# is meant to run somewhere other than the machine that built it, and a shipped
# default signing key is a key everyone has.

# Which published images to run. `latest` moves; pin the commit SHA for anything
# you need to be able to identify later.
TAG=latest

# ── Secrets ──────────────────────────────────────────────────────────────────
# openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRES_IN=7d

POSTGRES_USER=tasks
POSTGRES_PASSWORD=
POSTGRES_DB=sedjiwa_tasks_rs

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tasks-media
S3_REGION=us-east-1

# ── Origins ──────────────────────────────────────────────────────────────────
# Where the browser reaches the app. Used both for the API's CORS allow-list and
# for the storage bucket's CORS rule. Include the scheme and the port.
PUBLIC_APP_ORIGIN=http://localhost:3011

# Where the browser reaches object storage. Presigned upload URLs are absolute,
# so this must be the host:port the BROWSER can open — not http://rustfs:9000,
# which only resolves inside the compose network. On a single host that means
# the LAN IP or the public hostname, never 127.0.0.1 unless the browser runs
# on that same host.
PUBLIC_S3_ORIGIN=http://localhost:9100

# ── Ports published on the host ──────────────────────────────────────────────
APP_PORT=3011
S3_PORT=9100

# ── Optional: unattended first admin (profile `seed`) ────────────────────────
# Leave unset to create the first admin through the /setup page instead, which
# is the better path — the password is chosen by the person who will use it and
# never sits in a file.
# SEED_ADMIN_PHONE=0800000000
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Admin

RUST_LOG=info
