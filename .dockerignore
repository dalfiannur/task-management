# Context for both deploy/*.Dockerfile builds is the repository root.
# Everything below either bloats the context or is rebuilt inside the image.

# Rust build output — gigabytes, rebuilt inside the backend image.
apps/backend-rs/target/

# Reinstalled by bun inside the builder stage.
node_modules/
**/node_modules/

# Rebuilt by vite inside the builder stage.
apps/frontend/dist/

# Host-staged artifacts from earlier build schemes.
deploy/bin/
deploy/web/
deploy/.build-context/

.git/
.claude/
*.log
.env
.env.*
!.env.example
